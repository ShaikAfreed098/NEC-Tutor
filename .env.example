# Copy to .env.local. Never share or commit your keys.
# Preview works without accounts. Set NEC_MODE=live after completing setup.
NEC_MODE=preview
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key (sb_secret_...) or legacy service_role key. SERVER ONLY.
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# Search embeddings run locally with a fixed MPNet model. No embedding API key.
# Windows folder containing your subject folders.
MATERIALS_DIR=./Subject Pdfs
